{
  "evals": [
    {
      "id": "impl-plan-health-endpoint",
      "skill": "impl-plan",
      "prompt": "add a /health endpoint to this project that returns JSON {status: 'ok', version: string from package.json}",
      "target": ".",
      "assertions": [
        "has-all-sections",
        "zero-placeholders",
        "file-map-matches-steps",
        "steps-are-specific",
        "workstreams-defined",
        "manifest-valid",
        "delivery-slices-valid",
        "requirements-covered"
      ]
    },
    {
      "id": "review-plan-catches-flaws",
      "skill": "review-plan",
      "input_fixture": "fixtures/flawed-plan.md",
      "assertions": [
        "catches-placeholder-language",
        "catches-missing-observability",
        "catches-workstream-overlap",
        "findings-have-severity",
        "verdict-is-structured"
      ]
    },
    {
      "id": "review-plan-catches-delivery-slice-flaws",
      "skill": "review-plan",
      "input_fixture": "fixtures/flawed-delivery-slices-plan.md",
      "assertions": [
        "catches-forward-slice-dependency",
        "catches-duplicate-or-missing-slice-membership",
        "catches-missing-slice-evidence",
        "catches-unjustified-foundation-slice",
        "findings-have-severity",
        "verdict-is-structured"
      ]
    },
    {
      "id": "review-plan-no-false-positives",
      "skill": "review-plan",
      "input_fixture": "fixtures/clean-plan.md",
      "assertions": [
        "no-critical-findings",
        "findings-have-severity",
        "verdict-is-structured"
      ]
    },
    {
      "id": "review-plan-catches-evidence-contract-flaws",
      "skill": "review-plan",
      "input_fixture": "fixtures/flawed-evidence-contract-plan.md",
      "assertions": [
        "catches-unbound-approach-obligation",
        "catches-non-atomic-task",
        "findings-have-severity",
        "verdict-is-structured"
      ]
    },
    {
      "id": "verify-reports-evidence",
      "skill": "verify",
      "target": ".",
      "assertions": [
        "zero-banned-phrases",
        "commands-shown",
        "output-included",
        "verdict-present"
      ]
    },
    {
      "id": "verify-reports-failure",
      "skill": "verify",
      "target": "fixtures/failing-project",
      "assertions": ["verdict-failed", "failure-evidence-shown", "commands-shown"]
    },
    {
      "id": "verify-debt-gate-fails",
      "skill": "verify",
      "target": "fixtures/debt-project",
      "prompt": "Verify the project at {this-skill-dir}/fixtures/debt-project. Run all commands inside that directory. Treat {this-skill-dir}/fixtures/debt-project/plan.md as the plan under verification and use its execution_manifest.",
      "assertions": [
        "verdict-failed",
        "debt-scan-reported",
        "debt-unreferenced-flagged",
        "commands-shown"
      ]
    },
    {
      "id": "verify-debt-gate-deferred",
      "skill": "verify",
      "target": "fixtures/debt-project-deferred",
      "prompt": "Verify the project at {this-skill-dir}/fixtures/debt-project-deferred. Run all commands inside that directory. Treat {this-skill-dir}/fixtures/debt-project-deferred/plan.md as the plan under verification and use its execution_manifest.",
      "assertions": [
        "verdict-verified",
        "debt-scan-reported",
        "deferred-marker-listed",
        "commands-shown"
      ]
    },
    {
      "id": "verify-rejects-indirect-behavior-evidence",
      "skill": "verify",
      "target": "fixtures/behavioral-evidence-project",
      "prompt": "Verify the project at {this-skill-dir}/fixtures/behavioral-evidence-project. Run all commands inside that directory. Treat {this-skill-dir}/fixtures/behavioral-evidence-project/plan.md as the plan under verification and use its typed execution_manifest.",
      "assertions": [
        "verdict-partial",
        "behavioral-evidence-gap-shown",
        "commands-shown"
      ]
    },
    {
      "id": "architect-review-catches-flaws",
      "skill": "architect-review",
      "input_fixture": "fixtures/architect-review",
      "assertions": ["architect-verdict-present", "findings-have-severity", "catches-tautological-test", "catches-unplanned-file"]
    },
    {
      "id": "build-architect-phase-no-verify",
      "skill": "build",
      "state_fixture": "fixtures/orchestrator-architect-phase-no-verify",
      "state_slug": "cache-ttl",
      "assertions": [
        "orchestrator-next-phase-stated",
        "orchestrator-halts-on-missing-artifact",
        "orchestrator-does-not-review-unverified"
      ]
    },
    {
      "id": "build-verify-phase-clean-summary",
      "skill": "build",
      "state_fixture": "fixtures/orchestrator-verify-phase-clean-summary",
      "state_slug": "cache-ttl",
      "assertions": [
        "orchestrator-next-phase-stated",
        "orchestrator-routes-to-verify",
        "orchestrator-does-not-skip-to-complete",
        "orchestrator-treats-summary-as-provisional"
      ]
    },
    {
      "id": "build-plan-phase-fable-mode",
      "skill": "build",
      "state_fixture": "fixtures/orchestrator-plan-phase-fable-mode",
      "state_slug": "fable-mode",
      "assertions": ["orchestrator-fable-plan-active-session"]
    },
    {
      "id": "build-review-phase-mixed-mode",
      "skill": "build",
      "state_fixture": "fixtures/orchestrator-review-phase-mixed-mode",
      "state_slug": "mixed-mode",
      "assertions": ["orchestrator-mixed-relays-review"]
    },
    {
      "id": "build-review-phase-mixed-mode-relay-pending",
      "skill": "build",
      "state_fixture": "fixtures/orchestrator-review-phase-mixed-mode-relay-pending",
      "state_slug": "relay-pending",
      "assertions": ["orchestrator-mixed-resume-validates-relay"]
    }
  ]
}
